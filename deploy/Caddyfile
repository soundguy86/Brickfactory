# =============================================================================
# BandStage Pro – Caddy-Config
#
# TEST-Modus (Tailscale): Caddy serviert nur intern auf :8080 (HTTP),
# das HTTPS macht `tailscale serve` davor. Siehe deploy/DEPLOY.md.
#
# PROD-Modus (eigene Domain): die :8080-Zeile gegen deine Domain tauschen
# und `auto_https off` entfernen – dann holt Caddy automatisch ein
# öffentliches Let's-Encrypt-Zertifikat. Block unten ist auskommentiert.
# =============================================================================

{
	# Im Test-Setup terminiert Tailscale das TLS, Caddy bleibt reines HTTP.
	auto_https off
	admin off
}

:8080 {
	root * /var/www/bandstage
	encode zstd gzip
	file_server

	# Bei diesem MVP technisch nicht nötig (nur Anchor-Links), aber
	# zukunftssicher, falls später Client-Routing dazukommt.
	try_files {path} /index.html

	# Gehashte Assets dürfen ewig im Cache liegen …
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# … das HTML niemals (sonst seht ihr alte Builds).
	@html path / /index.html
	header @html Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}

	log {
		output file /var/log/caddy/bandstage.log
	}
}

# ---- PROD: später einkommentieren, Domain eintragen, :8080-Block entfernen ----
